# The image of the self-hosted OLM catalog, as generated by "opm generate dockerfile", but with a pinned opm version and
# the cache built on the build platform, which avoids emulation for multi-arch builds (the cache is portable). Both
# FROM lines must use the same opm version, the cache belongs to the opm that built it. The build context is the
# CATALOG_DIR of "make olm-catalog".

FROM --platform=${BUILDPLATFORM} quay.io/operator-framework/opm:v1.74.0 AS builder
ADD catalog /configs
RUN ["/bin/opm", "serve", "/configs", "--cache-dir=/tmp/cache", "--cache-only"]

FROM quay.io/operator-framework/opm:v1.74.0
ENTRYPOINT ["/bin/opm"]
CMD ["serve", "/configs", "--cache-dir=/tmp/cache"]
COPY --from=builder /configs /configs
COPY --from=builder /tmp/cache /tmp/cache
LABEL operators.operatorframework.io.index.configs.v1=/configs
