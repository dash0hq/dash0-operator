custom resource definition for SLOs should match snapshot:
  1: |
    apiVersion: apiextensions.k8s.io/v1
    kind: CustomResourceDefinition
    metadata:
      annotations:
        controller-gen.kubebuilder.io/version: v0.19.0
      labels:
        dash0.com/managed-by-operator: "true"
      name: slos.openslo.com
    spec:
      group: openslo.com
      names:
        kind: SLO
        listKind: SLOList
        plural: slos
        singular: slo
      scope: Namespaced
      versions:
        - name: v1
          schema:
            openAPIV3Schema:
              description: |-
                SLO is the Schema for the SLOs API. The spec is the subset of OpenSLO v1 that the Dash0 API supports, and its JSON
                shape mirrors the API's SloSpec field-for-field, so the controller carries it across without converting fields.
              properties:
                apiVersion:
                  description: |-
                    APIVersion defines the versioned schema of this representation of an object.
                    Servers should convert recognized schemas to the latest internal value, and
                    may reject unrecognized values.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources
                  type: string
                kind:
                  description: |-
                    Kind is a string value representing the REST resource this object represents.
                    Servers may infer this from the endpoint the client submits requests to.
                    Cannot be updated.
                    In CamelCase.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds
                  type: string
                metadata:
                  type: object
                spec:
                  description: SLOSpec defines the desired state of an SLO. The JSON tags match the Dash0 API SloSpec exactly.
                  properties:
                    budgetingMethod:
                      description: |-
                        BudgetingMethod is the error-budget accounting method. Only Occurrences (a ratio of good events to total
                        events) is supported by Dash0.
                      enum:
                        - Occurrences
                      type: string
                    description:
                      description: Description is an optional human-readable description of the SLO.
                      maxLength: 1050
                      type: string
                    indicator:
                      description: |-
                        Indicator is the inline service level indicator (SLI) for the SLO. Only an inline indicator with a ratioMetric
                        is supported; indicatorRef and thresholdMetric are not supported.
                      properties:
                        metadata:
                          description: Metadata holds optional metadata for the inline SLI.
                          properties:
                            displayName:
                              description: DisplayName is a human-readable display name for the SLI.
                              type: string
                            name:
                              description: Name is the name of the SLI.
                              type: string
                          type: object
                        spec:
                          description: Spec is the SLI specification.
                          properties:
                            ratioMetric:
                              description: RatioMetric is a ratio-based SLI metric with a good and a total Prometheus source.
                              properties:
                                counter:
                                  description: |-
                                    Counter indicates whether the underlying metric is a monotonically increasing counter (true) or a gauge-like
                                    value (false).
                                  type: boolean
                                good:
                                  description: Good is the metric source counting good (successful) events.
                                  properties:
                                    metricSource:
                                      description: MetricSource is the underlying metric source.
                                      properties:
                                        spec:
                                          description: Spec holds the data-source-specific query parameters (for Prometheus, a PromQL query).
                                          properties:
                                            query:
                                              description: Query is the PromQL query used to compute the metric.
                                              minLength: 1
                                              type: string
                                          required:
                                            - query
                                          type: object
                                        type:
                                          description: Type is the metric source type. Only "Prometheus" is supported.
                                          enum:
                                            - Prometheus
                                          type: string
                                      required:
                                        - spec
                                        - type
                                      type: object
                                  required:
                                    - metricSource
                                  type: object
                                total:
                                  description: Total is the metric source counting all events.
                                  properties:
                                    metricSource:
                                      description: MetricSource is the underlying metric source.
                                      properties:
                                        spec:
                                          description: Spec holds the data-source-specific query parameters (for Prometheus, a PromQL query).
                                          properties:
                                            query:
                                              description: Query is the PromQL query used to compute the metric.
                                              minLength: 1
                                              type: string
                                          required:
                                            - query
                                          type: object
                                        type:
                                          description: Type is the metric source type. Only "Prometheus" is supported.
                                          enum:
                                            - Prometheus
                                          type: string
                                      required:
                                        - spec
                                        - type
                                      type: object
                                  required:
                                    - metricSource
                                  type: object
                              required:
                                - good
                                - total
                              type: object
                          required:
                            - ratioMetric
                          type: object
                      required:
                        - spec
                      type: object
                    objectives:
                      description: Objectives are the objective thresholds for the SLO. Dash0 supports exactly one objective.
                      items:
                        description: |-
                          SLOObjective is an objective threshold for the SLO. Exactly one of target or targetPercent has to be set; they are
                          two spellings of the same budget target.
                        properties:
                          displayName:
                            description: DisplayName is a human-readable name for this objective.
                            type: string
                          target:
                            description: |-
                              Target is the budget target for this objective as a fraction in the range [0.0, 1.0) (for example, 0.99 for a
                              99 percent target). Mutually exclusive with targetPercent.
                            exclusiveMaximum: true
                            maximum: 1
                            minimum: 0
                            type: number
                          targetPercent:
                            description: |-
                              TargetPercent is the budget target for this objective as a percentage in the range [0.0, 100.0) (for example,
                              99 for a 99 percent target). Mutually exclusive with target.
                            exclusiveMaximum: true
                            maximum: 100
                            minimum: 0
                            type: number
                        type: object
                        x-kubernetes-validations:
                          - message: exactly one of target or targetPercent must be set
                            rule: has(self.target) != has(self.targetPercent)
                      maxItems: 1
                      minItems: 1
                      type: array
                    service:
                      description: Service is the name of the service this SLO is associated with.
                      type: string
                    timeWindow:
                      description: |-
                        TimeWindow is the time window over which the SLO is evaluated. At most one item is supported, and it must be a
                        rolling 28d (4w) window; calendar-aligned windows and other durations are rejected by the Dash0 API. When
                        omitted, a rolling 28d window is used.
                      items:
                        description: SLOTimeWindow is a rolling time window over which the SLO is evaluated.
                        properties:
                          duration:
                            description: |-
                              Duration is the length of the rolling window as an OpenSLO duration string. Dash0 evaluates SLOs over a fixed
                              28-day window, so only "28d" and its equivalent "4w" are accepted.
                            enum:
                              - 28d
                              - 4w
                            type: string
                          isRolling:
                            description: |-
                              IsRolling indicates whether this is a rolling time window. Dash0 only supports rolling windows, so this must
                              be set to true.
                            enum:
                              - true
                            type: boolean
                        required:
                          - duration
                          - isRolling
                        type: object
                      maxItems: 1
                      minItems: 1
                      type: array
                  required:
                    - budgetingMethod
                    - indicator
                    - objectives
                  type: object
                status:
                  description: SLOStatus defines the observed state of an SLO, in the same shape as Dash0SyntheticCheckStatus.
                  properties:
                    synchronizationResults:
                      items:
                        description: SLOSynchronizationResultPerEndpointAndDataset defines the synchronization result per endpoint and dataset.
                        properties:
                          dash0ApiEndpoint:
                            type: string
                          dash0Dataset:
                            type: string
                          dash0Id:
                            type: string
                          dash0Origin:
                            type: string
                          httpStatusCode:
                            description: |-
                              HttpStatusCode is the HTTP status code that the Dash0 API returned for the failed synchronization attempt, if the
                              failure was caused by an unexpected HTTP response. It is 0 (absent) for successful synchronizations and for
                              transport-level errors (network errors, timeouts) where no HTTP response was received. It is used to decide
                              whether a failed synchronization should be retried.
                            type: integer
                          synchronizationError:
                            type: string
                          synchronizationStatus:
                            description: |-
                              Dash0ApiResourceSynchronizationStatus describes the result of synchronizing a (non-third-party) Kubernetes resource
                              (e.g. synthetic checks) to the Dash0 API.
                            enum:
                              - successful
                              - partially-successful
                              - failed
                            type: string
                        required:
                          - synchronizationStatus
                        type: object
                      type: array
                    synchronizationStatus:
                      description: |-
                        Dash0ApiResourceSynchronizationStatus describes the result of synchronizing a (non-third-party) Kubernetes resource
                        (e.g. synthetic checks) to the Dash0 API.
                      enum:
                        - successful
                        - partially-successful
                        - failed
                      type: string
                    synchronizedAt:
                      format: date-time
                      type: string
                    validationIssues:
                      items:
                        type: string
                      type: array
                  required:
                    - synchronizationResults
                    - synchronizationStatus
                    - synchronizedAt
                  type: object
              type: object
          served: true
          storage: true
          subresources:
            status: {}
