custom resource definition for signal-to-metrics should match snapshot:
  1: |
    apiVersion: apiextensions.k8s.io/v1
    kind: CustomResourceDefinition
    metadata:
      annotations:
        controller-gen.kubebuilder.io/version: v0.19.0
      name: dash0signaltometrics.operator.dash0.com
    spec:
      group: operator.dash0.com
      names:
        kind: Dash0SignalToMetrics
        listKind: Dash0SignalToMetricsList
        plural: dash0signaltometrics
        singular: dash0signaltometrics
      scope: Namespaced
      versions:
        - name: v1alpha1
          schema:
            openAPIV3Schema:
              description: |-
                Dash0SignalToMetrics is the Schema for the dash0signaltometrics API.
                It defines a single rule that derives a custom metric from spans or log records.
              properties:
                apiVersion:
                  description: |-
                    APIVersion defines the versioned schema of this representation of an object.
                    Servers should convert recognized schemas to the latest internal value, and
                    may reject unrecognized values.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources
                  type: string
                kind:
                  description: |-
                    Kind is a string value representing the REST resource this object represents.
                    Servers may infer this from the endpoint the client submits requests to.
                    Cannot be updated.
                    In CamelCase.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds
                  type: string
                metadata:
                  type: object
                spec:
                  description: Dash0SignalToMetricsSpec defines the desired state of a SignalToMetrics rule.
                  properties:
                    alternativeDatasetId:
                      description: |-
                        The slug of the dataset the metric is written to. Required when targetDatasetMode is alternative or both, must
                        not be set otherwise.
                      pattern: \S
                      type: string
                    display:
                      description: Display configuration for the rule (e.g. the human-readable name shown in the Dash0 UI).
                      properties:
                        name:
                          description: Human-readable name for this rule.
                          minLength: 1
                          type: string
                      required:
                        - name
                      type: object
                    enabled:
                      description: Whether this rule is active.
                      type: boolean
                    match:
                      description: Match selects which signals this rule applies to.
                      properties:
                        filters:
                          description: Filters that determine which spans / log records contribute to the output metric.
                          items:
                            description: Dash0SignalToMetricsAttributeFilter is a single filter against an attribute key.
                            properties:
                              key:
                                description: The attribute key to match against.
                                minLength: 1
                                type: string
                              operator:
                                description: The match operator.
                                enum:
                                  - is
                                  - is_not
                                  - is_set
                                  - is_not_set
                                  - is_one_of
                                  - is_not_one_of
                                  - gt
                                  - lt
                                  - gte
                                  - lte
                                  - matches
                                  - does_not_match
                                  - contains
                                  - does_not_contain
                                  - starts_with
                                  - does_not_start_with
                                  - ends_with
                                  - does_not_end_with
                                  - is_any
                                type: string
                              value:
                                description: Single value for operators that accept one value (is, is_not, contains, matches, ...).
                                type: string
                              values:
                                description: List of values for the is_one_of / is_not_one_of operators.
                                items:
                                  type: string
                                type: array
                            required:
                              - key
                              - operator
                            type: object
                          minItems: 1
                          type: array
                        signal:
                          description: |-
                            The signal type this rule applies to. Unless output.type is set, spans produce exponential histograms of the span
                            duration and log records produce count metrics.
                          enum:
                            - spans
                            - logs
                          type: string
                      required:
                        - filters
                        - signal
                      type: object
                    output:
                      description: Output controls the metric that is produced for matching signals.
                      properties:
                        count:
                          description: |-
                            OTTL value expression for how many times value is recorded per matching signal. Only allowed when type is
                            exponential-histogram. Defaults to "1" when absent.
                          pattern: \S
                          type: string
                        description:
                          description: Optional description used as metadata on the generated metric.
                          type: string
                        interval:
                          description: 'Interval at which a data point is emitted for matched signals. Backend bounds: 5s..10m.'
                          pattern: ^(\d+(ms|s|m|h|d|w|M|Q|y))+$
                          type: string
                        keepResourceAttributes:
                          description: Key matchers that select resource attributes to carry over to the output metric.
                          items:
                            description: |-
                              Dash0SignalToMetricsMatcher is a key-less variant of an attribute filter used for keepResourceAttributes /
                              keepSignalAttributes selection: it matches against attribute keys.
                            properties:
                              operator:
                                description: The match operator.
                                enum:
                                  - is
                                  - is_not
                                  - is_set
                                  - is_not_set
                                  - is_one_of
                                  - is_not_one_of
                                  - gt
                                  - lt
                                  - gte
                                  - lte
                                  - matches
                                  - does_not_match
                                  - contains
                                  - does_not_contain
                                  - starts_with
                                  - does_not_start_with
                                  - ends_with
                                  - does_not_end_with
                                  - is_any
                                type: string
                              value:
                                description: Single value for operators that accept one value.
                                type: string
                              values:
                                description: List of values for the is_one_of / is_not_one_of operators.
                                items:
                                  type: string
                                type: array
                            required:
                              - operator
                            type: object
                          type: array
                        keepSignalAttributes:
                          description: |-
                            Key matchers that select span/log record attributes to carry over as metric dimensions. For spans rules without
                            type, the attribute otel.span.status.code is always added.
                          items:
                            description: |-
                              Dash0SignalToMetricsMatcher is a key-less variant of an attribute filter used for keepResourceAttributes /
                              keepSignalAttributes selection: it matches against attribute keys.
                            properties:
                              operator:
                                description: The match operator.
                                enum:
                                  - is
                                  - is_not
                                  - is_set
                                  - is_not_set
                                  - is_one_of
                                  - is_not_one_of
                                  - gt
                                  - lt
                                  - gte
                                  - lte
                                  - matches
                                  - does_not_match
                                  - contains
                                  - does_not_contain
                                  - starts_with
                                  - does_not_start_with
                                  - ends_with
                                  - does_not_end_with
                                  - is_any
                                type: string
                              value:
                                description: Single value for operators that accept one value.
                                type: string
                              values:
                                description: List of values for the is_one_of / is_not_one_of operators.
                                items:
                                  type: string
                                type: array
                            required:
                              - operator
                            type: object
                          type: array
                        maxSize:
                          description: |-
                            Maximum number of buckets per positive and negative range of the histogram. Only allowed when type is
                            exponential-histogram. Defaults to 160 when absent.
                          format: int32
                          maximum: 160
                          minimum: 1
                          type: integer
                        monotonic:
                          description: Whether the sum only increases. Only allowed when type is sum. Defaults to false when absent.
                          type: boolean
                        name:
                          description: The name of the resulting metric.
                          minLength: 1
                          type: string
                        type:
                          description: |-
                            The kind of metric to produce from the value expression, for both spans and logs rules. When absent, the metric
                            is derived from the signal: an exponential histogram of the span duration for spans, a monotonic count of
                            matching log records for logs.
                            - sum: cumulative float64 sum of value, monotonic when monotonic is true.
                            - gauge: float64 gauge holding the last value observed per series.
                            - exponential-histogram: exponential histogram of value, recorded count times.
                          enum:
                            - sum
                            - gauge
                            - exponential-histogram
                          type: string
                        value:
                          description: |-
                            OTTL value expression producing the number to record, evaluated in the span context for spans rules and the log
                            context for logs rules. Required when type is set, must be absent otherwise. A non-numeric, nil, or failing
                            result records no data point.
                          pattern: \S
                          type: string
                      required:
                        - interval
                        - name
                      type: object
                      x-kubernetes-validations:
                        - message: value must be set when type is set, and must not be set otherwise
                          rule: has(self.type) == has(self.value)
                        - message: monotonic is only allowed when type is 'sum'
                          rule: '!has(self.monotonic) || (has(self.type) && self.type == ''sum'')'
                        - message: maxSize is only allowed when type is 'exponential-histogram'
                          rule: '!has(self.maxSize) || (has(self.type) && self.type == ''exponential-histogram'')'
                        - message: count is only allowed when type is 'exponential-histogram'
                          rule: '!has(self.count) || (has(self.type) && self.type == ''exponential-histogram'')'
                    targetDatasetMode:
                      description: |-
                        Controls the dataset the generated metric is written to. Defaults to original when absent.
                        - original: the metric is written to the dataset the rule is synchronized to.
                        - alternative: the metric is written to the dataset specified by alternativeDatasetId.
                        - both: the metric is written to both datasets.
                      enum:
                        - original
                        - alternative
                        - both
                      type: string
                  required:
                    - display
                    - enabled
                    - match
                    - output
                  type: object
                  x-kubernetes-validations:
                    - message: alternativeDatasetId must be set when targetDatasetMode is 'alternative' or 'both', and must not be set otherwise
                      rule: (has(self.targetDatasetMode) && self.targetDatasetMode != 'original') == has(self.alternativeDatasetId)
                status:
                  description: Dash0SignalToMetricsStatus defines the observed state of a Dash0SignalToMetrics resource.
                  properties:
                    synchronizationResults:
                      items:
                        description: Dash0SignalToMetricsSynchronizationResultPerEndpointAndDataset captures the result of a single sync attempt.
                        properties:
                          dash0ApiEndpoint:
                            type: string
                          dash0Dataset:
                            type: string
                          dash0Id:
                            type: string
                          dash0Origin:
                            type: string
                          httpStatusCode:
                            description: |-
                              HttpStatusCode is the HTTP status code that the Dash0 API returned for the failed synchronization attempt, if the
                              failure was caused by an unexpected HTTP response. It is 0 (absent) for successful synchronizations and for
                              transport-level errors (network errors, timeouts) where no HTTP response was received. It is used to decide
                              whether a failed synchronization should be retried.
                            type: integer
                          synchronizationError:
                            type: string
                          synchronizationStatus:
                            description: |-
                              Dash0ApiResourceSynchronizationStatus describes the result of synchronizing a (non-third-party) Kubernetes resource
                              (e.g. synthetic checks) to the Dash0 API.
                            enum:
                              - successful
                              - partially-successful
                              - failed
                            type: string
                        required:
                          - synchronizationStatus
                        type: object
                      type: array
                    synchronizationStatus:
                      description: |-
                        Dash0ApiResourceSynchronizationStatus describes the result of synchronizing a (non-third-party) Kubernetes resource
                        (e.g. synthetic checks) to the Dash0 API.
                      enum:
                        - successful
                        - partially-successful
                        - failed
                      type: string
                    synchronizedAt:
                      format: date-time
                      type: string
                    validationIssues:
                      items:
                        type: string
                      type: array
                  required:
                    - synchronizationResults
                    - synchronizationStatus
                    - synchronizedAt
                  type: object
              type: object
          served: true
          storage: true
          subresources:
            status: {}
