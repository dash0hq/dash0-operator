                - --dash0-gke-autopilot=false
                - --dash0-openshift=false
                - --dash0-disable-otel-collector-host-ports=false
                - --dash0-otel-collector-otlp-grpc-host-port=40317
                - --dash0-otel-collector-otlp-http-host-port=40318
                - --dash0-log-level=info
              command:
                - /manager
              env:
                - name: GOMEMLIMIT
                  value: 205MiB
                - name: DASH0_OPERATOR_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                - name: DASH0_DEPLOYMENT_NAME
                  value: dash0-operator-controller
                - name: DASH0_WEBHOOK_SERVICE_NAME
                  value: dash0-operator-webhook-service
                - name: DASH0_WEBHOOK_SERVICE_PORT
                  value: "443"
                - name: DASH0_PERSES_DASHBOARD_AUTO_PATCH_CONVERSION_WEBHOOK
                  value: "true"
                - name: DASH0_IAC_PERIODIC_RETRY_ENABLED
                  value: "true"
