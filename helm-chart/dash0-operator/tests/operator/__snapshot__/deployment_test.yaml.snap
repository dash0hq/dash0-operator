                readOnlyRootFilesystem: true
                runAsGroup: 65532
                runAsNonRoot: true
                seccompProfile:
                  type: RuntimeDefault
              volumeMounts:
                - mountPath: /tmp/k8s-webhook-server/serving-certs
                  name: certificates
                  readOnly: true
                - mountPath: /etc/config
                  name: config-volume
                  readOnly: true
          securityContext:
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: dash0-operator-controller
          terminationGracePeriodSeconds: 15
          volumes:
            - name: certificates
              secret:
                defaultMode: 420
                secretName: dash0-operator-certificate-secret
            - configMap:
                name: dash0-operator-extra-config
              name: config-volume
