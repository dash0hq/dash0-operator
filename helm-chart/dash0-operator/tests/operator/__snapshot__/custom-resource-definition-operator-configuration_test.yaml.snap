                                        type: object
                                        x-kubernetes-validations:
                                          - message: exactly one of value or valueFrom has to be provided for a header
                                            rule: has(self.value) != has(self.valueFrom)
                                      type: array
                                    insecure:
                                      description: Whether to disable TLS. By default, TLS is used unless the endpoint starts with 'http://'.
                                      type: boolean
                                    insecureSkipVerify:
                                      description: |-
                                        Whether to skip verifying the server's certificate chain. It is a validation error to combine this with
                                        `insecure=true`, which disables TLS altogether.
                                      type: boolean
                                    keepalive:
                                      description: The client-side gRPC keepalive settings. There is usually no need to configure them.
                                      properties:
                                        permit_without_stream:
                                          description: Allow keepalive pings when there are no active streams.
                                          type: boolean
                                        time:
                                          description: Period after which a keepalive ping is sent on the transport.
                                          type: string
                                        timeout:
                                          description: Time to wait for a keepalive ping acknowledgement.
                                          type: string
                                      type: object
                                  required:
                                    - endpoint
                                  type: object
                                http:
                                  description: Settings for sending telemetry to an OTLP-compatible receiver via HTTP.
                                  properties:
                                    encoding:
                                      default: proto
                                      description: The encoding of the OTLP data when sent via HTTP. Can be either proto or json, defaults to proto.
                                      enum:
