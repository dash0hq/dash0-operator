                                                      type: string
                                                    name:
                                                      description: The name of the secret containing the value.
                                                      minLength: 1
                                                      type: string
                                                  required:
                                                    - key
                                                    - name
                                                  type: object
                                              required:
                                                - secretKeyRef
                                              type: object
                                          required:
                                            - name
                                          type: object
                                          x-kubernetes-validations:
                                            - message: exactly one of value or valueFrom has to be provided for a header
                                              rule: has(self.value) != has(self.valueFrom)
                                        type: array
                                      insecure:
                                        description: Whether to disable TLS. By default, TLS is used unless the endpoint starts with 'http://'.
