                      type: array
                    filter:
                      description: |-
                        Optional filters to drop spans, span events, metrics, metric data points, log records or profiles (see transform
                        for modifying telemetry). In contrast to the filters of a monitoring resource, they apply to all telemetry of the
                        cluster, including telemetry without a namespace, like node metrics. Telemetry is dropped if at least one
                        condition of these filters or of the monitoring resource's filters matches. It is a validation error to set
                        filters together with
                        `telemetryCollection.enabled=false`.
                      properties:
                        error_mode:
                          default: ignore
                          description: |-
                            How the filter processor reacts to errors returned by conditions:
                            - ignore (default, recommended): log the error and continue with the next condition.
                            - silent: continue with the next condition without logging the error.
                            - propagate: return the error up the pipeline, which drops the payload. Not recommended.
                            All filters of the cluster end up in a single filter processor, which uses the most severe of the configured error
                            modes (propagate > ignore > silent).
                          enum:
                            - ignore
                            - silent
                            - propagate
                          type: string
                        logs:
                          description: |-
                            Filters for the logs signal.
                            This can be used to drop _log records_.
                          properties:
                            log_records:
                              description: |-
                                OTTL conditions for dropping log records. A log record is dropped if at least one condition is true. Example:
                                - 'IsMatch(body, ".*password.*")'
                                - 'severity_number < SEVERITY_NUMBER_WARN'
                              items:
                                type: string
                              type: array
                          type: object
                        metrics:
                          description: |-
                            Filters for the metrics signal.
                            This can be used to drop entire _metrics_, or individual _data points_.
                          properties:
                            datapoint:
                              description: |-
                                OTTL conditions for dropping metric data points. A data point is dropped if at least one condition is true. A
                                metric whose data points are all dropped is dropped as well. Example:
                                - 'metric.name == "a.noisy.metric" and value_int == 0'
                                - 'resource.attributes["service.name"] == "my_service_name"'
                              items:
                                type: string
                              type: array
                            metric:
                              description: |-
                                OTTL conditions for dropping metrics. A metric is dropped if at least one condition is true. Example:
                                - 'name == "k8s.replicaset.available"'
                                - 'type == METRIC_DATA_TYPE_HISTOGRAM'
                              items:
                                type: string
                              type: array
                          type: object
                        profiles:
                          description: |-
                            Filters for the profiles signal.
                            This can be used to drop _profiles_.
                          properties:
                            profile:
                              description: OTTL conditions for dropping profiles. A profile is dropped if at least one condition is true.
                              items:
                                type: string
                              type: array
                          type: object
                        traces:
                          description: |-
                            Filters for the traces signal.
                            This can be used to drop _spans_ or _span events_.
                          properties:
                            span:
                              description: |-
                                OTTL conditions for dropping spans. A span is dropped if at least one condition is true. Example:
                                - 'attributes["http.route"] == "/ready"'
                                - 'attributes["http.route"] == "/metrics"'
                              items:
                                type: string
                              type: array
                            spanevent:
                              description: |-
                                OTTL conditions for dropping span events. A span event is dropped if at least one condition is true. The span
                                itself is kept, even if all of its span events are dropped.
                              items:
                                type: string
                              type: array
                          type: object
                      type: object
                    instrumentWorkloads:
                      default:
                        instrumentationDelivery: init-container
                      description: |-
                        Cluster-wide settings for the instrumentation of workloads. Per-namespace settings are in the monitoring
                        resources.
                      properties:
                        instrumentationDelivery:
                          default: init-container
                          description: |-
                            How the Dash0 instrumentation files are made available to instrumented workload containers:
                              - "auto": use image volumes if the Kubernetes API server and the kubelets of all nodes are 1.36 or later,
                                otherwise use an init container. The operator inspects the nodes once at startup and uses an init container
                                until then. Nodes joining the cluster later are not taken into account.
                              - "image-volume": always use an image volume sourced from the Dash0 instrumentation image. If the operator has
                                detected that the API server or the kubelet of a node is older than 1.31, it logs a warning and falls back to
                                an init container. That fallback does not cover workloads instrumented before the nodes have been inspected,
                                nor nodes that join later. Kubernetes 1.34 and earlier need the image volume feature gate enabled at cluster
                                creation time.
                              - "init-container" (default): always use an init container plus emptyDir volume.
                            Changing this setting does not re-instrument existing workloads. It applies to workloads that are deployed or
                            updated afterwards.
                          enum:
                            - auto
                            - image-volume
                            - init-container
                          type: string
                      type: object
                    kubernetesInfrastructureMetricsCollection:
                      description: Settings for collecting Kubernetes infrastructure metrics.
                      properties:
                        enabled:
                          description: |-
                            Whether to collect Kubernetes infrastructure metrics. Defaults to `true`, or to `false` if
                            `telemetryCollection.enabled=false`, in which case setting it to `true` is a validation error.
                          type: boolean
                      type: object
                    kubernetesInfrastructureMetricsCollectionEnabled:
                      description: 'Deprecated: Use `kubernetesInfrastructureMetricsCollection.enabled` instead.'
                      type: boolean
                    kubernetesObjectCollection:
                      description: Settings for collecting the manifests of Kubernetes objects.
                      properties:
                        collectClusterScopedObjects:
                          description: |-
                            Opt-out for collecting the manifests of nodes and persistent volumes. Defaults to `true`. They are only collected
                            if `kubernetesObjectCollection.enabled` is `true` and at least one Dash0Monitoring resource has opted into
                            Kubernetes object collection.
                          type: boolean
                        enabled:
                          description: |-
                            Cluster-wide opt-in for collecting Kubernetes object manifests. Defaults to `false`. If enabled, the operator
                            collects the manifests of pods and workloads in every namespace whose Dash0Monitoring resource has
                            `kubernetesObjectCollection.enabled=true`, as well as those of nodes and persistent volumes. If disabled, no
                            manifests are collected. It is a validation error to set it to `true` together with
                            `telemetryCollection.enabled=false`.
                          type: boolean
                      type: object
                    monitoringTemplate:
                      description: |-
                        MonitoringTemplate describes the Dash0Monitoring resources that will be created for namespaces in case
                        automatic namespace monitoring is enabled.
                      properties:
                        metadata:
                          type: object
                          x-kubernetes-preserve-unknown-fields: true
                        spec:
                          description: |-
