                              type: object
                            eventCollection:
                              description: Settings for collecting Kubernetes events in the target namespace.
                              properties:
                                enabled:
                                  description: |-
                                    Opt-out for collecting Kubernetes events in the target namespace. Defaults to `true`, or to `false` if the
                                    operator configuration resource has `telemetryCollection.enabled=false`, in which case setting it to `true` is a
                                    validation error.
                                  type: boolean
                              type: object
                            export:
                              description: |-
                                Deprecated: Use `exports` instead. If both `export` and `exports` are specified, `export` is ignored. The mutating
                                webhook migrates `export` to `exports` if only `export` is specified.
                              minProperties: 1
                              properties:
                                dash0:
                                  description: Settings for sending telemetry to Dash0.
                                  properties:
                                    apiEndpoint:
                                      description: |-
                                        The API endpoint of your Dash0 organization, see
                                        https://app.dash0.com/goto/settings/endpoints?endpoint_type=api_http. It starts with `https://api.` and ends in
                                        `.dash0.com`. It is not used for telemetry, but for managing dashboards, check rules, synthetic checks and views
                                        via the operator.
                                      type: string
                                    authorization:
                                      description: The authorization settings for sending data to Dash0. Exactly one of token and secretRef has to be provided.
                                      maxProperties: 1
                                      minProperties: 1
                                      properties:
                                        secretRef:
                                          description: A reference to a Kubernetes secret containing the Dash0 authorization token.
                                          properties:
                                            key:
                                              default: token
                                              description: The key of the value which contains the Dash0 authorization token. Defaults to "token"
                                              type: string
                                            name:
                                              default: dash0-authorization-secret
                                              description: The name of the secret containing the Dash0 authorization token. Defaults to "dash0-authorization-secret".
                                              type: string
                                          required:
                                            - key
                                            - name
                                          type: object
                                        token:
                                          description: The Dash0 authorization token, see https://app.dash0.com/settings/auth-tokens.
                                          type: string
                                      type: object
                                    dataset:
                                      description: |-
                                        The identifier (not the display name) of the Dash0 dataset to which telemetry data will be sent, see
                                        https://app.dash0.com/settings/datasets. If omitted, Dash0 selects the dataset based on the authorization token,
                                        and API access (dashboards, check rules, etc.) uses the dataset "default".
                                      type: string
                                    endpoint:
                                      description: |-
                                        The OTLP/gRPC endpoint of your Dash0 organization, see
                                        https://app.dash0.com/goto/settings/endpoints?endpoint_type=otlp_grpc. It starts with `ingress.` and ends in
                                        `dash0.com:4317`.
                                      minLength: 1
                                      type: string
                                    keepalive:
                                      description: The client-side gRPC keepalive settings. There is usually no need to configure them.
                                      properties:
                                        permit_without_stream:
                                          description: Allow keepalive pings when there are no active streams.
                                          type: boolean
                                        time:
                                          description: Period after which a keepalive ping is sent on the transport.
                                          type: string
                                        timeout:
                                          description: Time to wait for a keepalive ping acknowledgement.
                                          type: string
                                      type: object
                                  required:
                                    - authorization
                                    - endpoint
                                  type: object
                                grpc:
                                  description: Settings for sending telemetry to an OTLP-compatible receiver via gRPC.
                                  properties:
                                    balancer_name:
                                      description: The load balancer to use, round_robin or pick_first. When omitted, the collector's default (round_robin) is used.
                                      enum:
                                        - round_robin
                                        - pick_first
                                      type: string
                                    endpoint:
                                      description: The URL of the OTLP-compatible receiver to which telemetry data will be sent.
                                      type: string
                                    headers:
                                      description: Additional headers to be sent with each gRPC request, for example for authorization.
                                      items:
                                        description: Header describes a single header to be sent with each request. Exactly one of value and valueFrom has to be provided.
                                        properties:
                                          name:
                                            description: The name of the header.
                                            type: string
                                          value:
                                            description: The value of the header as a literal string.
                                            minLength: 1
                                            type: string
                                          valueFrom:
                                            description: |-
                                              The value of the header, sourced from a Kubernetes secret. Use this for sensitive values like authorization tokens
                                              or API keys.
                                            properties:
                                              secretKeyRef:
                                                description: A reference to a key in a Kubernetes secret containing the header value.
                                                properties:
                                                  key:
                                                    description: The key within the secret which contains the value.
                                                    minLength: 1
                                                    type: string
                                                  name:
                                                    description: The name of the secret containing the value.
                                                    minLength: 1
                                                    type: string
                                                required:
                                                  - key
                                                  - name
                                                type: object
                                            required:
                                              - secretKeyRef
                                            type: object
                                        required:
