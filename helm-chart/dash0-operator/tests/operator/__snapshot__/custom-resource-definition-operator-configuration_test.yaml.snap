                    profiling:
                      description: Profiling describes the profiling configuration for the operator.
                      properties:
                        ebpfProfiler:
                          description: |-
                            Settings for the node-level eBPF profiler. Enabling it requires profiling and telemetry collection to be enabled,
                            and the eBPF profiler to be enabled via Helm.
                          properties:
                            cpuSamplingFrequency:
                              default: 19
                              description: CPU sampling frequency in samples per second. Defaults to 19.
                              format: int32
                              minimum: 1
                              type: integer
                            debuginfo:
                              description: Settings for uploading debug information to Dash0 exports. Other export types do not receive debug information.
                              properties:
                                maxConcurrentUploads:
                                  default: 25
                                  description: Maximum number of concurrent uploads. Defaults to 25.
                                  format: int32
                                  minimum: 1
                                  type: integer
                                queueSize:
                                  default: 4096
                                  description: Maximum number of queued uploads. Defaults to 4096.
                                  format: int32
                                  minimum: 1
                                  type: integer
                                uploadEnabled:
                                  default: true
                                  description: |-
                                    Whether to upload debug information to each configured Dash0 export. Defaults to true. Uploads are only active
                                    when the eBPF profiler, profiling and telemetry collection are enabled.
                                  type: boolean
                              type: object
                            enableErrorFrames:
                              default: false
                              description: Whether to collect error frames. Defaults to false.
                              type: boolean
                            enabled:
                              default: false
                              description: Whether to deploy the eBPF profiler. This requires an explicit opt-in and defaults to false.
                              type: boolean
                            logLevel:
                              description: The profiler's log level. When omitted, the profiler uses its default log level.
                              enum:
                                - error
                                - warn
                                - info
                                - debug
                              type: string
                            mapScaleFactor:
                              default: 0
                              description: Scaling factor for eBPF map sizes. Each increment doubles the map size. Defaults to 0.
                              format: int32
                              maximum: 8
                              minimum: 0
                              type: integer
                            offCPUThreshold:
                              default: 0
                              description: The probability of recording an off-CPU event, from 0 to 1. Defaults to 0, which disables off-CPU profiling.
                              maximum: 1
                              minimum: 0
                              type: number
                            pidNamespaceTranslationMode:
                              description: |-
                                PID namespace translation mode. When omitted, the agent defaults to none. Use auto for nested PID namespaces,
                                such as kind: it uses recursive translation when supported, otherwise exact. Exact collects processes in the
                                agent's PID namespace; recursive also collects descendants and requires kernel BTF.
                              enum:
                                - none
                                - auto
                                - exact
                                - recursive
                              type: string
                            probabilisticSampling:
                              description: |-
                                Settings for probabilistic CPU profiling. When omitted, CPU sampling is always active. Off-CPU sampling is not
                                affected by probabilistic toggling.
                              properties:
                                interval:
                                  default: 1m
                                  description: Duration of each interval for which CPU sampling is enabled or disabled. Defaults to 1m, must be between 1m and 5m.
                                  type: string
                                  x-kubernetes-validations:
                                    - message: interval must be between 1m and 5m
                                      rule: duration(self) >= duration('1m') && duration(self) <= duration('5m')
                                threshold:
                                  default: 100
                                  description: |-
                                    Integer threshold for probabilistic CPU profiling, from 1 to 100. At each interval, sampling is active when a
                                    random integer from 0 to 99 is less than this threshold. Defaults to 100, which keeps CPU sampling always active.
                                  format: int32
                                  maximum: 100
                                  minimum: 1
                                  type: integer
                              type: object
                            tracers:
                              description: |-
                                Tracers to enable. When omitted or empty, defaults to python, hotspot, php, ruby, perl, v8, dotnet, beam, luajit,
                                labels and cuda. An explicit list replaces these defaults. Native tracing is always enabled. Go frames use native
                                tracing, not in-agent Go symbolization. The labels tracer enables Go goroutine labels and native custom labels.
