                              description: |-
                                Whether to skip verifying the server's certificate chain. It is a validation error to combine this with
                                `insecure=true`, which disables TLS altogether.
                              type: boolean
                            keepalive:
                              description: The client-side gRPC keepalive settings. There is usually no need to configure them.
                              properties:
                                permit_without_stream:
                                  description: Allow keepalive pings when there are no active streams.
