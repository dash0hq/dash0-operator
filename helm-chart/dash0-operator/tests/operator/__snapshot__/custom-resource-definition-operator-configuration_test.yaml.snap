custom resource definition for operator configuration should match snapshot:
  1: |
    apiVersion: apiextensions.k8s.io/v1
    kind: CustomResourceDefinition
    metadata:
      annotations:
        controller-gen.kubebuilder.io/version: v0.19.0
      name: dash0operatorconfigurations.operator.dash0.com
    spec:
      group: operator.dash0.com
      names:
        kind: Dash0OperatorConfiguration
        listKind: Dash0OperatorConfigurationList
        plural: dash0operatorconfigurations
        singular: dash0operatorconfiguration
      scope: Cluster
      versions:
        - additionalPrinterColumns:
            - jsonPath: .spec.telemetryCollection.enabled
              name: Collect Telemetry
              type: boolean
            - jsonPath: .spec.kubernetesInfrastructureMetricsCollection.enabled
              name: Collect Metrics
              type: boolean
            - jsonPath: .spec.collectPodLabelsAndAnnotations.enabled
              name: Collect Pod Meta
              type: boolean
            - jsonPath: .spec.collectNamespaceLabelsAndAnnotations.enabled
              name: Collect Namespace Meta
              type: boolean
            - jsonPath: .spec.collectNodeLabelsAndAnnotations.enabled
              name: Collect Node Meta
              type: boolean
            - jsonPath: .status.conditions[?(@.type == "Available")].status
              name: Available
              type: string
            - jsonPath: .metadata.creationTimestamp
              name: Age
              type: date
          name: v1alpha1
          schema:
            openAPIV3Schema:
              description: Dash0OperatorConfiguration is the schema for the Dash0OperatorConfiguration API
              properties:
                apiVersion:
                  description: |-
                    APIVersion defines the versioned schema of this representation of an object.
                    Servers should convert recognized schemas to the latest internal value, and
                    may reject unrecognized values.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources
                  type: string
                kind:
                  description: |-
                    Kind is a string value representing the REST resource this object represents.
                    Servers may infer this from the endpoint the client submits requests to.
                    Cannot be updated.
                    In CamelCase.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds
                  type: string
                metadata:
                  type: object
                spec:
                  description: Dash0OperatorConfigurationSpec describes cluster-wide configuration settings for the Dash0 operator.
                  properties:
                    __dash0_internal__normalizedTransform:
                      description: Only used internally, this field must not be specified by users.
                      properties:
                        error_mode:
                          description: FilterTransformErrorMode determines how the filter or the transform processor reacts to errors.
                          enum:
                            - ignore
                            - silent
                            - propagate
                          type: string
                        log_statements:
                          items:
                            properties:
                              conditions:
                                items:
                                  type: string
                                type: array
                              context:
                                type: string
                              error_mode:
                                description: FilterTransformErrorMode determines how the filter or the transform processor reacts to errors.
                                enum:
                                  - ignore
                                  - silent
                                  - propagate
                                type: string
                              statements:
                                items:
                                  type: string
                                type: array
                            type: object
                          type: array
                        metric_statements:
                          items:
                            properties:
                              conditions:
                                items:
                                  type: string
                                type: array
                              context:
                                type: string
                              error_mode:
                                description: FilterTransformErrorMode determines how the filter or the transform processor reacts to errors.
                                enum:
                                  - ignore
                                  - silent
                                  - propagate
                                type: string
                              statements:
                                items:
                                  type: string
                                type: array
                            type: object
                          type: array
                        profile_statements:
                          items:
                            properties:
                              conditions:
                                items:
                                  type: string
                                type: array
                              context:
                                type: string
                              error_mode:
                                description: FilterTransformErrorMode determines how the filter or the transform processor reacts to errors.
                                enum:
                                  - ignore
                                  - silent
                                  - propagate
                                type: string
                              statements:
                                items:
                                  type: string
                                type: array
                            type: object
                          type: array
                        trace_statements:
                          items:
                            properties:
                              conditions:
                                items:
                                  type: string
                                type: array
                              context:
                                type: string
                              error_mode:
                                description: FilterTransformErrorMode determines how the filter or the transform processor reacts to errors.
                                enum:
                                  - ignore
                                  - silent
                                  - propagate
                                type: string
                              statements:
                                items:
                                  type: string
                                type: array
                            type: object
                          type: array
                      type: object
                    agent0Connector:
                      description: Settings for the agent0-connector.
                      properties:
                        enabled:
                          description: |-
                            An opt-out switch for the agent0-connector deployment. This setting is optional. Setting it to `false` prevents the
                            operator from deploying the agent0-connector, even when the agent0-connector is enabled via the Helm chart. It is a
                            validation error to set it to `true` when the agent0-connector is disabled via the Helm chart.

                            Using this setting to disable agent0-connector when it is enabled via Helm and the Helm chart manages the
                            Dash0OperatorConfiguration resource (operator.dash0Export.enabled=true) is not supported.
                          type: boolean
                      type: object
                    autoMonitorNamespaces:
                      default:
                        enabled: false
                        labelSelector: dash0.com/enable!=false
                      description: Settings for automatically monitoring namespaces.
                      properties:
                        enabled:
                          default: false
                          description: |-
                            Whether the operator automatically adds a Dash0Monitoring resource to all existing namespaces at startup and to
                            new namespaces when they are created, based on spec.monitoringTemplate. Namespaces can opt out via
                            spec.autoMonitorNamespaces.labelSelector. Defaults to `false`.
                          type: boolean
                        labelSelector:
                          default: dash0.com/enable!=false
                          description: |-
                            A label selector for the namespaces that are monitored automatically. It is only used if
                            spec.autoMonitorNamespaces.enabled is true. The default "dash0.com/enable!=false" matches all namespaces except
                            those with the label dash0.com/enable=false.
                          type: string
                      required:
                        - enabled
                      type: object
                    clusterName:
                      description: If set, the value is added to all telemetry as the resource attribute k8s.cluster.name.
                      type: string
                    collectNamespaceLabelsAndAnnotations:
                      description: Settings for collecting namespace labels and annotations as resource attributes.
                      properties:
                        enabled:
                          description: |-
                            Opt-in for collecting namespace labels and annotations as resource attributes. Defaults to `false`. It is a
                            validation error to set it to `true` together with `telemetryCollection.enabled=false`.
                          type: boolean
                      type: object
                    collectNodeLabelsAndAnnotations:
                      description: Settings for collecting node labels and annotations as resource attributes.
                      properties:
                        enabled:
                          description: |-
                            Opt-in for collecting node labels and annotations as resource attributes. Defaults to `false`. It is a validation
                            error to set it to `true` together with `telemetryCollection.enabled=false`.
                          type: boolean
                      type: object
                    collectPodLabelsAndAnnotations:
                      description: Settings for collecting pod labels and annotations as resource attributes.
                      properties:
                        enabled:
                          description: |-
                            Opt-out for collecting pod labels and annotations as resource attributes. Defaults to `true`, or to `false` if
                            `telemetryCollection.enabled=false`, in which case setting it to `true` is a validation error.
                          type: boolean
                      type: object
                    components:
                      description: |-
                        Settings for the workloads the operator manages. Every setting in this section is optional. A setting that is
                        absent keeps the value provided via the Helm chart. A setting that is present replaces the Helm value, and the
                        fields it leaves out take their defaults, not the values provided via Helm: resources are merged with the default
                        resources per resource, probes with the default probes per field, and the required and the preferred node affinity
                        each replace their default. An empty object
                        (e.g. containerResources: {}, probes: {}, nodeAffinity: {}) therefore means the defaults, and an empty mTls
                        disables mTLS. Empty labels, annotations, podLabels, podAnnotations, tolerations and sysctls and an empty
                        priorityClassName count as absent. A setting that Kubernetes would reject in the pod template of the workload, and
                        an invalid GOMEMLIMIT, are rejected. A setting that replaces a custom Helm value with a different one is reported
                        as a warning in the operator log, and as an admission warning when spec.components is created or changed.
                      properties:
                        agent0Connector:
                          description: |-
                            Settings for the agent0-connector. Its cluster role rules can only be configured via the Helm chart, since the
                            operator can only grant permissions it holds itself.
                          properties:
                            allowedKubectlCommands:
                              description: |-
                                The kubectl commands the agent0-connector may execute (Helm value operator.agent0Connector.allowedKubectlCommands).
                                The settings are merged with the defaults of the Helm chart per command, not with the commands provided via Helm:
                                a command that is not set here keeps its default. At least one command needs to stay enabled. Allowing a command
                                does not grant the RBAC permissions it needs (Helm value operator.agent0Connector.clusterRole.additionalRules or
                                operator.agent0Connector.clusterRole.rules).
                              properties:
                                apiResources:
                                  description: kubectl api-resources, enabled by default.
                                  type: boolean
                                apiVersions:
                                  description: kubectl api-versions, enabled by default.
                                  type: boolean
                                auth:
                                  description: kubectl auth, enabled by default.
                                  type: boolean
                                clusterInfo:
                                  description: kubectl cluster-info, enabled by default.
                                  type: boolean
                                events:
                                  description: |-
                                    kubectl events, disabled by default. Events are not redacted, only enable this if no sensitive information like
                                    credentials, API tokens, secrets or customer PII is leaked into event bodies. It needs RBAC access to events (core
                                    API group) and events.events.k8s.io. While it is disabled, reading events via kubectl get is rejected as well.
                                  type: boolean
                                explain:
                                  description: kubectl explain, enabled by default.
                                  type: boolean
                                get:
                                  description: kubectl get, enabled by default. It is the main kubectl command that Agent0 uses.
                                  type: boolean
                                logs:
                                  description: |-
                                    kubectl logs, disabled by default. Logs cannot be redacted reliably, only enable this if no sensitive information is
                                    leaked into logs. It needs RBAC access to pods/log, and also lifts the redaction of container termination messages
                                    (which can hold log output) in the output of kubectl get.
                                  type: boolean
                                top:
                                  description: kubectl top, enabled by default.
                                  type: boolean
                                version:
                                  description: kubectl version, enabled by default.
                                  type: boolean
                              type: object
                            annotations:
                              additionalProperties:
                                type: string
                              description: |-
                                Additional annotations for the workload. They replace the annotations provided via the Helm chart, empty
                                annotations keep them.
                              type: object
                            containerResources:
                              description: The resources of the agent0-connector container (Helm value operator.agent0Connector.containerResources).
                              properties:
                                gomemlimit:
                                  description: |-
                                    The GOMEMLIMIT in the format of the Go runtime (e.g. 400MiB, not 400Mi), or off. If empty (recommended), it is
                                    derived from the memory limit. It must be greater than 0 and below the effective memory limit. In
                                    collectorContainerResources, it should also be below the memory_limiter soft limit.
                                  pattern: ^(off|[0-9]+(([KMGT]i)?B)?)$
                                  type: string
                                limits:
                                  additionalProperties:
                                    anyOf:
                                      - type: integer
                                      - type: string
                                    pattern: ^(\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))))?$
                                    x-kubernetes-int-or-string: true
                                  description: |-
                                    The resource limits. Only cpu, memory and ephemeral-storage are supported. A resource that is not set here keeps
                                    its default limit, and -1 removes it. A default limit below the request set in requests is raised to that request.
                                  type: object
                                requests:
                                  additionalProperties:
                                    anyOf:
                                      - type: integer
                                      - type: string
                                    pattern: ^(\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))))?$
                                    x-kubernetes-int-or-string: true
                                  description: |-
                                    The resource requests. Only cpu, memory and ephemeral-storage are supported. A resource that is not set here keeps
                                    its default request, and -1 removes it. A default request above the limit set in limits is lowered to that limit.
                                    A request above the limit set in limits is rejected.
                                  type: object
                              type: object
                            enablePprof:
                              description: |-
                                Whether to enable pprof for the agent0-connector pod (Helm value operator.agent0Connector.enablePprof, default
                                false). Only enable this if instructed by Dash0 support.
                              type: boolean
                            labels:
                              additionalProperties:
                                type: string
                              description: Additional labels for the workload. They replace the labels provided via the Helm chart, empty labels keep them.
                              type: object
                            maxConcurrentCommands:
                              description: |-
                                The number of command requests the agent0-connector executes at the same time (Helm value
                                operator.agent0Connector.maxConcurrentCommands, default 2). Raising this value requires raising
                                containerResources.limits.memory correspondingly, and containerResources.gomemlimit, if it is set.
                              format: int32
                              minimum: 1
                              type: integer
                            nodeAffinity:
                              description: |-
                                The node affinity for the pods of the workload. The required and the preferred node affinity each replace the
                                default of the Helm chart (not the one provided via Helm), unless they are absent. The default requires nodes that
                                run Linux and are not labelled with dash0.com/enable=false, and has no preferred node affinity. A required node
                                affinity with an empty list of nodeSelectorTerms removes it.
                              properties:
                                preferredDuringSchedulingIgnoredDuringExecution:
                                  description: |-
                                    The scheduler will prefer to schedule pods to nodes that satisfy
                                    the affinity expressions specified by this field, but it may choose
                                    a node that violates one or more of the expressions. The node that is
                                    most preferred is the one with the greatest sum of weights, i.e.
                                    for each node that meets all of the scheduling requirements (resource
                                    request, requiredDuringScheduling affinity expressions, etc.),
                                    compute a sum by iterating through the elements of this field and adding
                                    "weight" to the sum if the node matches the corresponding matchExpressions; the
                                    node(s) with the highest sum are the most preferred.
                                  items:
                                    description: |-
                                      An empty preferred scheduling term matches all objects with implicit weight 0
                                      (i.e. it's a no-op). A null preferred scheduling term matches no objects (i.e. is also a no-op).
                                    properties:
                                      preference:
                                        description: A node selector term, associated with the corresponding weight.
                                        properties:
                                          matchExpressions:
                                            description: A list of node selector requirements by node's labels.
                                            items:
                                              description: |-
                                                A node selector requirement is a selector that contains values, a key, and an operator
                                                that relates the key and values.
                                              properties:
                                                key:
                                                  description: The label key that the selector applies to.
                                                  type: string
                                                operator:
                                                  description: |-
                                                    Represents a key's relationship to a set of values.
                                                    Valid operators are In, NotIn, Exists, DoesNotExist. Gt, and Lt.
                                                  type: string
                                                values:
                                                  description: |-
                                                    An array of string values. If the operator is In or NotIn,
                                                    the values array must be non-empty. If the operator is Exists or DoesNotExist,
                                                    the values array must be empty. If the operator is Gt or Lt, the values
                                                    array must have a single element, which will be interpreted as an integer.
                                                    This array is replaced during a strategic merge patch.
                                                  items:
                                                    type: string
                                                  type: array
                                                  x-kubernetes-list-type: atomic
                                              required:
                                                - key
                                                - operator
                                              type: object
                                            type: array
                                            x-kubernetes-list-type: atomic
                                          matchFields:
                                            description: A list of node selector requirements by node's fields.
                                            items:
                                              description: |-
                                                A node selector requirement is a selector that contains values, a key, and an operator
                                                that relates the key and values.
                                              properties:
                                                key:
                                                  description: The label key that the selector applies to.
                                                  type: string
                                                operator:
                                                  description: |-
                                                    Represents a key's relationship to a set of values.
                                                    Valid operators are In, NotIn, Exists, DoesNotExist. Gt, and Lt.
                                                  type: string
                                                values:
                                                  description: |-
                                                    An array of string values. If the operator is In or NotIn,
                                                    the values array must be non-empty. If the operator is Exists or DoesNotExist,
                                                    the values array must be empty. If the operator is Gt or Lt, the values
                                                    array must have a single element, which will be interpreted as an integer.
                                                    This array is replaced during a strategic merge patch.
                                                  items:
                                                    type: string
                                                  type: array
                                                  x-kubernetes-list-type: atomic
                                              required:
                                                - key
                                                - operator
                                              type: object
                                            type: array
                                            x-kubernetes-list-type: atomic
                                        type: object
                                        x-kubernetes-map-type: atomic
                                      weight:
                                        description: Weight associated with matching the corresponding nodeSelectorTerm, in the range 1-100.
                                        format: int32
                                        type: integer
                                    required:
                                      - preference
                                      - weight
                                    type: object
                                  type: array
                                  x-kubernetes-list-type: atomic
                                requiredDuringSchedulingIgnoredDuringExecution:
                                  description: |-
                                    If the affinity requirements specified by this field are not met at
                                    scheduling time, the pod will not be scheduled onto the node.
                                    If the affinity requirements specified by this field cease to be met
                                    at some point during pod execution (e.g. due to an update), the system
                                    may or may not try to eventually evict the pod from its node.
                                  properties:
                                    nodeSelectorTerms:
                                      description: Required. A list of node selector terms. The terms are ORed.
                                      items:
                                        description: |-
                                          A null or empty node selector term matches no objects. The requirements of
                                          them are ANDed.
                                          The TopologySelectorTerm type implements a subset of the NodeSelectorTerm.
                                        properties:
                                          matchExpressions:
                                            description: A list of node selector requirements by node's labels.
                                            items:
                                              description: |-
                                                A node selector requirement is a selector that contains values, a key, and an operator
                                                that relates the key and values.
                                              properties:
                                                key:
                                                  description: The label key that the selector applies to.
                                                  type: string
                                                operator:
                                                  description: |-
                                                    Represents a key's relationship to a set of values.
                                                    Valid operators are In, NotIn, Exists, DoesNotExist. Gt, and Lt.
                                                  type: string
                                                values:
                                                  description: |-
                                                    An array of string values. If the operator is In or NotIn,
                                                    the values array must be non-empty. If the operator is Exists or DoesNotExist,
                                                    the values array must be empty. If the operator is Gt or Lt, the values
                                                    array must have a single element, which will be interpreted as an integer.
                                                    This array is replaced during a strategic merge patch.
                                                  items:
                                                    type: string
                                                  type: array
                                                  x-kubernetes-list-type: atomic
                                              required:
                                                - key
                                                - operator
                                              type: object
                                            type: array
                                            x-kubernetes-list-type: atomic
                                          matchFields:
                                            description: A list of node selector requirements by node's fields.
                                            items:
                                              description: |-
                                                A node selector requirement is a selector that contains values, a key, and an operator
                                                that relates the key and values.
                                              properties:
                                                key:
                                                  description: The label key that the selector applies to.
                                                  type: string
                                                operator:
                                                  description: |-
                                                    Represents a key's relationship to a set of values.
                                                    Valid operators are In, NotIn, Exists, DoesNotExist. Gt, and Lt.
                                                  type: string
                                                values:
                                                  description: |-
                                                    An array of string values. If the operator is In or NotIn,
                                                    the values array must be non-empty. If the operator is Exists or DoesNotExist,
                                                    the values array must be empty. If the operator is Gt or Lt, the values
                                                    array must have a single element, which will be interpreted as an integer.
                                                    This array is replaced during a strategic merge patch.
                                                  items:
                                                    type: string
                                                  type: array
                                                  x-kubernetes-list-type: atomic
                                              required:
                                                - key
                                                - operator
                                              type: object
                                            type: array
                                            x-kubernetes-list-type: atomic
                                        type: object
                                        x-kubernetes-map-type: atomic
                                      type: array
                                      x-kubernetes-list-type: atomic
                                  required:
                                    - nodeSelectorTerms
                                  type: object
                                  x-kubernetes-map-type: atomic
                              type: object
                            podAnnotations:
                              additionalProperties:
                                type: string
                              description: |-
                                Additional annotations for the pods of the workload. They replace the pod annotations provided via the Helm
                                chart, empty pod annotations keep them.
                              type: object
                            podLabels:
                              additionalProperties:
                                type: string
                              description: |-
                                Additional labels for the pods of the workload. They replace the pod labels provided via the Helm chart, empty
                                pod labels keep them.
                              type: object
                            tolerations:
                              description: |-
                                Tolerations for the pods of the workload. They replace the tolerations provided via the Helm chart, empty
                                tolerations keep them. Only the operators Equal and Exists are supported.
                              items:
                                description: |-
                                  The pod this Toleration is attached to tolerates any taint that matches
                                  the triple <key,value,effect> using the matching operator <operator>.
                                properties:
                                  effect:
                                    description: |-
                                      Effect indicates the taint effect to match. Empty means match all taint effects.
                                      When specified, allowed values are NoSchedule, PreferNoSchedule and NoExecute.
                                    type: string
                                  key:
                                    description: |-
                                      Key is the taint key that the toleration applies to. Empty means match all taint keys.
                                      If the key is empty, operator must be Exists; this combination means to match all values and all keys.
                                    type: string
                                  operator:
                                    description: |-
                                      Operator represents a key's relationship to the value.
                                      Valid operators are Exists, Equal, Lt, and Gt. Defaults to Equal.
                                      Exists is equivalent to wildcard for value, so that a pod can
                                      tolerate all taints of a particular category.
                                      Lt and Gt perform numeric comparisons (requires feature gate TaintTolerationComparisonOperators).
                                    type: string
                                  tolerationSeconds:
                                    description: |-
                                      TolerationSeconds represents the period of time the toleration (which must be
                                      of effect NoExecute, otherwise this field is ignored) tolerates the taint. By default,
                                      it is not set, which means tolerate the taint forever (do not evict). Zero and
                                      negative values will be treated as 0 (evict immediately) by the system.
                                    format: int64
                                    type: integer
                                  value:
                                    description: |-
                                      Value is the taint value the toleration matches to.
                                      If the operator is Exists, the value should be empty, otherwise just a regular string.
                                    type: string
                                type: object
                              type: array
                          type: object
                        daemonSetCollector:
                          description: Settings for the OpenTelemetry collector DaemonSet.
                          properties:
                            annotations:
                              additionalProperties:
                                type: string
                              description: |-
                                Additional annotations for the workload. They replace the annotations provided via the Helm chart, empty
                                annotations keep them.
                              type: object
                            collectorContainerResources:
                              description: |-
                                The resources of the OpenTelemetry collector container (Helm value
                                operator.collectors.daemonSetCollectorContainerResources).
                              properties:
                                gomemlimit:
                                  description: |-
                                    The GOMEMLIMIT in the format of the Go runtime (e.g. 400MiB, not 400Mi), or off. If empty (recommended), it is
                                    derived from the memory limit. It must be greater than 0 and below the effective memory limit. In
                                    collectorContainerResources, it should also be below the memory_limiter soft limit.
                                  pattern: ^(off|[0-9]+(([KMGT]i)?B)?)$
                                  type: string
                                limits:
                                  additionalProperties:
                                    anyOf:
                                      - type: integer
                                      - type: string
                                    pattern: ^(\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))))?$
                                    x-kubernetes-int-or-string: true
                                  description: |-
                                    The resource limits. Only cpu, memory and ephemeral-storage are supported. A resource that is not set here keeps
                                    its default limit, and -1 removes it. A default limit below the request set in requests is raised to that request.
                                  type: object
                                requests:
                                  additionalProperties:
                                    anyOf:
                                      - type: integer
                                      - type: string
                                    pattern: ^(\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))))?$
                                    x-kubernetes-int-or-string: true
                                  description: |-
                                    The resource requests. Only cpu, memory and ephemeral-storage are supported. A resource that is not set here keeps
                                    its default request, and -1 removes it. A default request above the limit set in limits is lowered to that limit.
                                    A request above the limit set in limits is rejected.
                                  type: object
                              type: object
                            configurationReloaderContainerResources:
                              description: |-
                                The resources of the configuration reloader container (Helm value
                                operator.collectors.daemonSetConfigurationReloaderContainerResources).
                              properties:
                                gomemlimit:
                                  description: |-
                                    The GOMEMLIMIT in the format of the Go runtime (e.g. 400MiB, not 400Mi), or off. If empty (recommended), it is
                                    derived from the memory limit. It must be greater than 0 and below the effective memory limit. In
                                    collectorContainerResources, it should also be below the memory_limiter soft limit.
                                  pattern: ^(off|[0-9]+(([KMGT]i)?B)?)$
                                  type: string
                                limits:
                                  additionalProperties:
                                    anyOf:
                                      - type: integer
