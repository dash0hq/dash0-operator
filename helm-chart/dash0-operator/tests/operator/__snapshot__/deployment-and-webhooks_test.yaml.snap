                        type: object
                    type: object
                  type: array
                filter:
                  description: |-
                    Optional filters to drop spans, span events, metrics, metric data points, log records or profiles collected in
                    this namespace (see transform for modifying telemetry). It is a validation error to set filters while the operator
                    configuration resource has `telemetryCollection.enabled=false`.
                  properties:
                    error_mode:
                      default: ignore
                      description: |-
                        How the filter processor reacts to errors returned by conditions:
                        - ignore (default, recommended): log the error and continue with the next condition.
                        - silent: continue with the next condition without logging the error.
                        - propagate: return the error up the pipeline, which drops the payload. Not recommended.
                        All filters of the cluster end up in a single filter processor, which uses the most severe of the configured error
                        modes (propagate > ignore > silent).
                      enum:
                        - ignore
                        - silent
                        - propagate
                      type: string
                    logs:
                      description: |-
                        Filters for the logs signal.
                        This can be used to drop _log records_.
                      properties:
                        log_records:
                          description: |-
                            OTTL conditions for dropping log records. A log record is dropped if at least one condition is true. Example:
                            - 'IsMatch(body, ".*password.*")'
                            - 'severity_number < SEVERITY_NUMBER_WARN'
                          items:
                            type: string
                          type: array
                      type: object
                    metrics:
                      description: |-
                        Filters for the metrics signal.
                        This can be used to drop entire _metrics_, or individual _data points_.
                      properties:
                        datapoint:
                          description: |-
                            OTTL conditions for dropping metric data points. A data point is dropped if at least one condition is true. A
                            metric whose data points are all dropped is dropped as well. Example:
                            - 'metric.name == "a.noisy.metric" and value_int == 0'
                            - 'resource.attributes["service.name"] == "my_service_name"'
                          items:
                            type: string
                          type: array
                        metric:
                          description: |-
                            OTTL conditions for dropping metrics. A metric is dropped if at least one condition is true. Example:
                            - 'name == "k8s.replicaset.available"'
                            - 'type == METRIC_DATA_TYPE_HISTOGRAM'
                          items:
                            type: string
                          type: array
                      type: object
                    profiles:
                      description: |-
                        Filters for the profiles signal.
                        This can be used to drop _profiles_.
                      properties:
                        profile:
                          description: OTTL conditions for dropping profiles. A profile is dropped if at least one condition is true.
                          items:
                            type: string
                          type: array
                      type: object
                    traces:
                      description: |-
                        Filters for the traces signal.
                        This can be used to drop _spans_ or _span events_.
                      properties:
                        span:
                          description: |-
                            OTTL conditions for dropping spans. A span is dropped if at least one condition is true. Example:
                            - 'attributes["http.route"] == "/ready"'
                            - 'attributes["http.route"] == "/metrics"'
                          items:
                            type: string
                          type: array
                        spanevent:
                          description: |-
                            OTTL conditions for dropping span events. A span event is dropped if at least one condition is true. The span
                            itself is kept, even if all of its span events are dropped.
                          items:
                            type: string
                          type: array
                      type: object
                  type: object
                instrumentWorkloads:
                  description: |-
                    Settings for the automatic instrumentation of workloads in the target namespace. Cluster-wide instrumentation
                    settings are in the operator configuration resource.
                  properties:
                    captureSqlQueryParameters:
                      description: |-
                        If set to true, the operator enables SQL query parameter capture in the OpenTelemetry Java agent (JDBC) and the
                        OpenTelemetry .NET auto-instrumentation (Microsoft.Data.SqlClient, Entity Framework Core). It sets the following
                        environment variables to "true" in instrumented containers, unless a container sets them to a different value:
                          - OTEL_INSTRUMENTATION_JDBC_EXPERIMENTAL_CAPTURE_QUERY_PARAMETERS
                          - OTEL_DOTNET_EXPERIMENTAL_SQLCLIENT_ENABLE_TRACE_DB_QUERY_PARAMETERS
                          - OTEL_DOTNET_EXPERIMENTAL_EFCORE_ENABLE_TRACE_DB_QUERY_PARAMETERS
                        The parameter values are added to the database spans and may include sensitive data such as PII. These
                        experimental agent flags may be renamed or removed in future agent releases. If the setting is later set to false
                        or removed, the operator removes each variable whose value is still "true".
                      type: boolean
                    labelSelector:
                      default: dash0.com/enable!=false
                      description: |-
                        A label selector for per-workload control over instrumentation: Only workloads that match it are instrumented. It
                        is ignored if spec.instrumentWorkloads.mode is `none`. The default "dash0.com/enable!=false" matches all workloads
                        except those with the label dash0.com/enable=false. A selector with equals instead of not-equals (e.g.
                        "auto-instrument-this-workload-with-dash0=true") implements an opt-in model instead.
                      type: string
                    mode:
                      description: |-
                        Which events trigger the instrumentation of workloads in the target namespace, and whether workloads or pods are
                        instrumented:
                        * `all` (default): The operator instruments existing workloads when the Dash0 monitoring resource is deployed,
                          instruments existing workloads or updates their instrumentation when the operator starts or restarts (e.g. when
                          it is updated), and instruments new workloads when they are deployed and changed workloads when they are
                          updated. Instrumenting existing workloads restarts their pods.
                        * `created-and-updated`: The operator only instruments new workloads when they are deployed and changed workloads
                          when they are updated. This avoids pod restarts when the monitoring resource is deployed or the operator
                          restarts.
                        * `pods`: The operator does not modify workloads (deployments, daemon sets, stateful sets, replica sets, jobs, cron
                          jobs), but instruments each pod when it is created. It never restarts pods: Existing pods keep their state until
                          they are recreated (e.g. by the next rollout), also when the operator is updated, the mode is changed to `none`
                          or the monitoring resource is removed. Hence, a workload can run instrumented and uninstrumented pods side by
                          side. Instrumentation that a pod template still has from an earlier mode is removed with the next update of the
                          workload, unless that would replace pods that would not be replaced otherwise. If the mode is changed to `none`
                          or the monitoring resource is removed before that, the pod template is reverted, which replaces the pods. The
                          label selector is evaluated against the labels of the pod combined with those of its owners, the level closest
                          to the pod wins; the other modes only use the labels of the workload. Use this mode to avoid drift reports by
                          GitOps or infrastructure-as-code tools.
                        * `none`: Workloads in the target namespace are never instrumented.
                        If the operator configuration resource has `telemetryCollection.enabled=false`, the default is `none`, and any
                        other mode is a validation error. Individual workloads can be excluded via the label dash0.com/enable=false or
                        spec.instrumentWorkloads.labelSelector.
                      enum:
                        - all
                        - created-and-updated
                        - pods
                        - none
                      type: string
                    traceContext:
                      description: Optional settings for how trace context is handled in instrumented workloads.
                      properties:
                        propagators:
                          description: |-
                            A comma-separated list of trace context propagators, e.g. "tracecontext,xray" for the W3C traceparent header and
                            AWS X-Ray headers. If set, it is added to workloads as the environment variable OTEL_PROPAGATORS (the SDK default
                            is "tracecontext,baggage"). If several propagators extract the same information, the last one wins, so list the
                            preferred propagator last.
                          type: string
                      type: object
                  type: object
                kubernetesObjectCollection:
                  description: Settings for collecting the manifests of pods and workloads in the target namespace.
                  properties:
                    enabled:
                      description: |-
                        Opt-in for sending the manifests of pods, deployments, replica sets, stateful sets and daemon sets in the target
                        namespace to Dash0 as log records. Defaults to `false`. Values of environment variables and the annotations in
                        which deploy tools (kubectl, kapp, Rancher) store a copy of the whole manifest are removed before the manifests
                        leave the cluster.
                      type: boolean
                  type: object
                logCollection:
                  description: Settings for collecting pod logs in the target namespace.
                  properties:
                    enabled:
                      description: |-
                        Opt-out for collecting pod logs in the target namespace. Defaults to `true`, or to `false` if the operator
                        configuration resource has `telemetryCollection.enabled=false`, in which case setting it to `true` is a
                        validation error.
                      type: boolean
                  type: object
                prometheusScraping:
                  description: Settings for scraping Prometheus metrics from pods in the target namespace.
                  properties:
                    enabled:
                      description: |-
                        Whether to scrape metrics from pods in the target namespace according to their prometheus.io/scrape annotations.
                        Defaults to `true`, or to `false` if the operator configuration resource has `telemetryCollection.enabled=false`,
                        in which case setting it to `true` is a validation error.
                      type: boolean
                  type: object
                synchronizePersesDashboards:
                  default: true
                  description: |-
                    Whether to synchronize the Perses dashboard resources in this namespace to Dash0 via the Dash0 API. Defaults to
                    `true`.
                  type: boolean
                synchronizePrometheusRules:
                  default: true
                  description: |-
                    Whether to synchronize the Prometheus rule resources in this namespace to Dash0 check rules via the Dash0 API.
                    Defaults to `true`.
                  type: boolean
                transform:
                  description: |-
                    Optional transformations for telemetry collected in this namespace, e.g. to remove span, metric data point or log
                    record attributes (see filter for dropping telemetry). The OTTL statements of each signal type are applied in the
                    given order. Only the basic config style of the transform processor is supported, see
                    https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/processor/transformprocessor. It is a
                    validation error to set transforms while the operator configuration resource has
                    `telemetryCollection.enabled=false`.
                  properties:
                    error_mode:
                      default: ignore
                      description: |-
                        How the transform processor reacts to errors returned by statements:
                        - ignore (default): log the error and continue with the next statement.
                        - silent: continue with the next statement without logging the error.
                        - propagate: return the error up the pipeline, which drops the payload.
                        All transforms of the cluster end up in a single transform processor, which uses the most severe of the
                        configured error modes (propagate > ignore > silent).
                      enum:
                        - ignore
                        - silent
                        - propagate
                      type: string
                    log_statements:
                      description: Transform statements (or groups) for the log signal type.
                      x-kubernetes-preserve-unknown-fields: true
                    metric_statements:
                      description: Transform statements (or groups) for the metric signal type.
                      x-kubernetes-preserve-unknown-fields: true
                    profile_statements:
                      description: Transform statements (or groups) for the profile signal type.
                      x-kubernetes-preserve-unknown-fields: true
                    trace_statements:
                      description: Transform statements (or groups) for the trace signal type.
                      x-kubernetes-preserve-unknown-fields: true
                  type: object
              required:
                - synchronizePersesDashboards
                - synchronizePrometheusRules
              type: object
            status:
              description: Dash0MonitoringStatus defines the observed state of the Dash0Monitoring monitoring resource.
              properties:
                conditions:
                  items:
                    description: Condition contains details for one aspect of the current state of this API Resource.
                    properties:
                      lastTransitionTime:
                        description: |-
                          lastTransitionTime is the last time the condition transitioned from one status to another.
                          This should be when the underlying condition changed.  If that is not known, then using the time when the API field changed is acceptable.
                        format: date-time
                        type: string
                      message:
                        description: |-
                          message is a human readable message indicating details about the transition.
                          This may be an empty string.
                        maxLength: 32768
                        type: string
                      observedGeneration:
                        description: |-
                          observedGeneration represents the .metadata.generation that the condition was set based upon.
                          For instance, if .metadata.generation is currently 12, but the .status.conditions[x].observedGeneration is 9, the condition is out of date
                          with respect to the current state of the instance.
                        format: int64
                        minimum: 0
                        type: integer
                      reason:
                        description: |-
                          reason contains a programmatic identifier indicating the reason for the condition's last transition.
                          Producers of specific condition types may define expected values and meanings for this field,
                          and whether the values are considered a guaranteed API.
                          The value should be a CamelCase string.
                          This field may not be empty.
                        maxLength: 1024
                        minLength: 1
                        pattern: ^[A-Za-z]([A-Za-z0-9_,:]*[A-Za-z0-9_])?$
                        type: string
                      status:
                        description: status of the condition, one of True, False, Unknown.
                        enum:
                          - "True"
                          - "False"
                          - Unknown
                        type: string
                      type:
                        description: type of condition in CamelCase or in foo.example.com/CamelCase.
                        maxLength: 316
                        pattern: ^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])$
                        type: string
                    required:
                      - lastTransitionTime
                      - message
                      - reason
                      - status
                      - type
                    type: object
                  type: array
                persesDashboardSynchronizationResults:
                  additionalProperties:
                    properties:
                      synchronizationResults:
                        items:
                          properties:
                            dash0ApiEndpoint:
                              type: string
                            dash0Dataset:
                              type: string
                            dash0Origin:
                              type: string
                            httpStatusCode:
                              description: |-
                                HttpStatusCode is the HTTP status code that the Dash0 API returned for the failed synchronization attempt, if the
                                failure was caused by an unexpected HTTP response. It is 0 (absent) for successful synchronizations and for
                                transport-level errors (network errors, timeouts) where no HTTP response was received. It is used to decide
                                whether a failed synchronization should be retried.
                              type: integer
                            synchronizationError:
                              type: string
                          required:
                            - dash0ApiEndpoint
                          type: object
                        type: array
                      synchronizationStatus:
                        description: |-
                          ThirdPartySynchronizationStatus describes the result of synchronizing a third-party Kubernetes resource (Perses
                          dashboard, Prometheus rule) to the Dash0 API.
                        enum:
                          - successful
                          - partially-successful
                          - failed
                        type: string
                      synchronizedAt:
                        format: date-time
                        type: string
                      validationIssues:
                        items:
                          type: string
                        type: array
                    type: object
                  description: Shows results of synchronizing Perses dashboard resources in this namespace via the Dash0 API.
                  type: object
                previousInstrumentWorkloads:
                  description: The spec.instrumentWorkloads.mode setting that has been observed in the previous reconcile cycle.
                  properties:
                    captureSqlQueryParameters:
                      description: |-
                        If set to true, the operator enables SQL query parameter capture in the OpenTelemetry Java agent (JDBC) and the
                        OpenTelemetry .NET auto-instrumentation (Microsoft.Data.SqlClient, Entity Framework Core). It sets the following
                        environment variables to "true" in instrumented containers, unless a container sets them to a different value:
                          - OTEL_INSTRUMENTATION_JDBC_EXPERIMENTAL_CAPTURE_QUERY_PARAMETERS
                          - OTEL_DOTNET_EXPERIMENTAL_SQLCLIENT_ENABLE_TRACE_DB_QUERY_PARAMETERS
                          - OTEL_DOTNET_EXPERIMENTAL_EFCORE_ENABLE_TRACE_DB_QUERY_PARAMETERS
                        The parameter values are added to the database spans and may include sensitive data such as PII. These
                        experimental agent flags may be renamed or removed in future agent releases. If the setting is later set to false
                        or removed, the operator removes each variable whose value is still "true".
                      type: boolean
                    labelSelector:
                      default: dash0.com/enable!=false
                      description: |-
                        A label selector for per-workload control over instrumentation: Only workloads that match it are instrumented. It
                        is ignored if spec.instrumentWorkloads.mode is `none`. The default "dash0.com/enable!=false" matches all workloads
                        except those with the label dash0.com/enable=false. A selector with equals instead of not-equals (e.g.
                        "auto-instrument-this-workload-with-dash0=true") implements an opt-in model instead.
                      type: string
                    mode:
                      description: |-
                        Which events trigger the instrumentation of workloads in the target namespace, and whether workloads or pods are
                        instrumented:
                        * `all` (default): The operator instruments existing workloads when the Dash0 monitoring resource is deployed,
                          instruments existing workloads or updates their instrumentation when the operator starts or restarts (e.g. when
                          it is updated), and instruments new workloads when they are deployed and changed workloads when they are
                          updated. Instrumenting existing workloads restarts their pods.
                        * `created-and-updated`: The operator only instruments new workloads when they are deployed and changed workloads
                          when they are updated. This avoids pod restarts when the monitoring resource is deployed or the operator
                          restarts.
                        * `pods`: The operator does not modify workloads (deployments, daemon sets, stateful sets, replica sets, jobs, cron
                          jobs), but instruments each pod when it is created. It never restarts pods: Existing pods keep their state until
                          they are recreated (e.g. by the next rollout), also when the operator is updated, the mode is changed to `none`
                          or the monitoring resource is removed. Hence, a workload can run instrumented and uninstrumented pods side by
                          side. Instrumentation that a pod template still has from an earlier mode is removed with the next update of the
                          workload, unless that would replace pods that would not be replaced otherwise. If the mode is changed to `none`
                          or the monitoring resource is removed before that, the pod template is reverted, which replaces the pods. The
                          label selector is evaluated against the labels of the pod combined with those of its owners, the level closest
                          to the pod wins; the other modes only use the labels of the workload. Use this mode to avoid drift reports by
                          GitOps or infrastructure-as-code tools.
                        * `none`: Workloads in the target namespace are never instrumented.
                        If the operator configuration resource has `telemetryCollection.enabled=false`, the default is `none`, and any
                        other mode is a validation error. Individual workloads can be excluded via the label dash0.com/enable=false or
                        spec.instrumentWorkloads.labelSelector.
                      enum:
                        - all
                        - created-and-updated
                        - pods
                        - none
                      type: string
                    traceContext:
                      description: Optional settings for how trace context is handled in instrumented workloads.
                      properties:
                        propagators:
                          description: |-
                            A comma-separated list of trace context propagators, e.g. "tracecontext,xray" for the W3C traceparent header and
                            AWS X-Ray headers. If set, it is added to workloads as the environment variable OTEL_PROPAGATORS (the SDK default
                            is "tracecontext,baggage"). If several propagators extract the same information, the last one wins, so list the
                            preferred propagator last.
                          type: string
                      type: object
                  type: object
                previousLogCollection:
                  description: |-
                    The spec.logCollection setting that has been observed in the previous reconcile cycle. Used to detect when log
                    collection has been toggled, which requires re-instrumenting workloads so that OTEL_LOGS_EXPORTER is
                    added/removed accordingly.
                  properties:
                    enabled:
                      description: |-
                        Opt-out for collecting pod logs in the target namespace. Defaults to `true`, or to `false` if the operator
                        configuration resource has `telemetryCollection.enabled=false`, in which case setting it to `true` is a
                        validation error.
                      type: boolean
                  type: object
                prometheusRuleSynchronizationResults:
                  additionalProperties:
                    properties:
                      alertingRulesTotal:
                        type: integer
                      invalidRules:
                        additionalProperties:
                          items:
                            type: string
                          type: array
                        type: object
                      invalidRulesTotal:
                        type: integer
                      recordingRulesTotal:
                        type: integer
                      synchronizationResults:
                        items:
                          properties:
                            dash0ApiEndpoint:
                              type: string
                            dash0Dataset:
                              type: string
                            synchronizationErrorHttpStatusCodes:
                              additionalProperties:
                                type: integer
                              description: |-
                                SynchronizationErrorHttpStatusCodes maps the name of a rule that failed to synchronize to the HTTP status code
                                that the Dash0 API returned for that rule, if the failure was caused by an unexpected HTTP response. The status
                                code is 0 (absent) for transport-level errors (network errors, timeouts) where no HTTP response was received. It
                                is used to decide whether a failed synchronization should be retried. The keys match the keys of
                                SynchronizationErrors.
                              type: object
                            synchronizationErrors:
                              additionalProperties:
                                type: string
                              type: object
                            synchronizationErrorsTotal:
                              type: integer
                            synchronizedRulesAttributes:
                              additionalProperties:
                                properties:
                                  dash0Origin:
                                    type: string
                                type: object
                              type: object
                            synchronizedRulesTotal:
                              type: integer
                          required:
                            - dash0ApiEndpoint
                          type: object
                        type: array
                      synchronizationStatus:
                        description: |-
                          ThirdPartySynchronizationStatus describes the result of synchronizing a third-party Kubernetes resource (Perses
                          dashboard, Prometheus rule) to the Dash0 API.
                        enum:
                          - successful
                          - partially-successful
                          - failed
                        type: string
                      synchronizedAt:
                        format: date-time
                        type: string
                    type: object
                  description: Shows results of synchronizing Prometheus rule resources in this namespace via the Dash0 API.
                  type: object
              type: object
          type: object
      served: true
      storage: true
      subresources:
        status: {}
webhook service should match snapshot (default settings):
  1: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app.kubernetes.io/component: webhook-service
        app.kubernetes.io/instance: webhook-service
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: dash0-operator
        app.kubernetes.io/part-of: dash0-operator
        app.kubernetes.io/version: 0.0.0
        helm.sh/chart: dash0-operator-0.0.0
      name: dash0-operator-webhook-service
      namespace: NAMESPACE
    spec:
      ports:
        - port: 443
          protocol: TCP
          targetPort: 9443
      selector:
        app.kubernetes.io/component: controller
        app.kubernetes.io/name: dash0-operator
