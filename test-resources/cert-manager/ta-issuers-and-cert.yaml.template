---
apiVersion: cert-manager.io/v1
kind: Issuer
metadata:
  name: ta-selfsigned-issuer
spec:
  selfSigned: {}

---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: ta-mtls-ca
spec:
  isCA: true
  commonName: dash0-operator-opentelemetry-target-allocator
  # Much longer than the duration of the server and client certificates, so the CA never renews together with them.
  duration: 17520h # 2 years
  # Keep the key when the CA renews, so certificates signed before and after the renewal are valid for both CA
  # certificates.
  privateKey:
    rotationPolicy: Never
  secretName: ta-mtls-ca-secret
  issuerRef:
    name: ta-selfsigned-issuer
    kind: Issuer

---
apiVersion: cert-manager.io/v1
kind: Issuer
metadata:
  name: ta-mtls-ca-issuer
spec:
  ca:
    secretName: ta-mtls-ca-secret

---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: ta-server-cert
spec:
  dnsNames:
    - dash0-operator-opentelemetry-target-allocator-service
    - dash0-operator-opentelemetry-target-allocator-service.$OPERATOR_NAMESPACE.svc
    - dash0-operator-opentelemetry-target-allocator-service.$OPERATOR_NAMESPACE.svc.cluster.local
  # Well below one third of the CA duration, so this certificate is renewed before the old CA certificate in its secret
  # expires.
  duration: 2160h # 90 days
  privateKey:
    rotationPolicy: Always
  secretName: ta-server-cert-secret
  issuerRef:
    name: ta-mtls-ca-issuer
    kind: Issuer

---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: ta-client-cert
spec:
  commonName: ta-client
  # Well below one third of the CA duration, so this certificate is renewed before the old CA certificate in its secret
  # expires.
  duration: 2160h # 90 days
  privateKey:
    rotationPolicy: Always
  secretName: ta-client-cert-secret
  issuerRef:
    name: ta-mtls-ca-issuer
    kind: Issuer
