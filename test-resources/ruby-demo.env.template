# Configuration for the Ruby auto-instrumentation demo.
# Copy this file to test-resources/ruby-demo.env and fill in your values.

# REQUIRED: Dash0 authorization token. Copy this from your Dash0 account → Settings → Auth Tokens.
DASH0_AUTHORIZATION_TOKEN=auth_your_token_here

# REQUIRED: Dash0 ingress endpoint (gRPC, no https://).
# EU West 1 (dev):  ingress.eu-west-1.aws.dash0-dev.com:4317
# EU West 1 (prod): ingress.eu-west-1.aws.dash0.com:4317
DASH0_INGRESS_ENDPOINT=ingress.eu-west-1.aws.dash0-dev.com:4317

# REQUIRED: Dash0 API endpoint.
# EU West 1 (dev):  https://api.eu-west-1.aws.dash0-dev.com
# EU West 1 (prod): https://api.eu-west-1.aws.dash0.com
DASH0_API_ENDPOINT=https://api.eu-west-1.aws.dash0-dev.com

# OPTIONAL: Dash0 dataset (defaults to 'default').
DASH0_DATASET=default

# OPTIONAL: Kind cluster name (defaults to 'dash0-ruby-demo').
KIND_CLUSTER_NAME=dash0-ruby-demo

# OPTIONAL: Kubernetes namespace for the Ruby demo apps (defaults to 'ruby-demo').
TARGET_NAMESPACE=ruby-demo

# OPTIONAL: Kubernetes namespace where the operator is installed (defaults to 'dash0-system').
OPERATOR_NAMESPACE=dash0-system
